  {
   "id": "984f6cee-0c49-491c-baa7-869eff922b48",
   "memory": "Assistant added that even without code changes, the small size of the head and cache vectors allows training on the CPU of a 910B machine.\n\n**attributed_to**: \"assistant\"",
   "user_id": "o9cq80w9VpKJq9SaClYSc_EwYF1E@im.wechat",
